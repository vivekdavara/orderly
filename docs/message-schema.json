        "amount_cents": {
          "exclusiveMinimum": 0,
          "maximum": 1000000000000,
          "title": "Amount Cents",
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
